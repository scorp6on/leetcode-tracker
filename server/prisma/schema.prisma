// ============================================================================
// Prisma schema
// ----------------------------------------------------------------------------
// This file is the single source of truth for the database structure.
// Workflow:
//   1. Edit the models below.
//   2. Run `npm run prisma:migrate` -> Prisma writes a SQL migration file,
//      applies it to the database, and regenerates the typed client.
//   3. Import { PrismaClient } and query with full type-safety.
// ============================================================================

generator client {
  // Generates the typed query client into node_modules/@prisma/client.
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Reads the connection string from server/.env at migrate/generate time.
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------
// Prisma enums become real PostgreSQL enum types. They give you a fixed set of
// allowed values, checked by both the database and the TypeScript compiler.

/// LeetCode's three difficulty levels.
enum Difficulty {
  EASY
  MEDIUM
  HARD
}

/// How an attempt went. This is the coarse signal; `confidence` and
/// `failureMode` add detail.
enum Outcome {
  SOLVED // got it working, reasonably cleanly
  STRUGGLED // solved it eventually but it was rough / needed hints
  FAILED // did not solve it
}

/// The seven diagnosable reasons an attempt went wrong. Optional on an attempt —
/// you only set it when the outcome wasn't a clean solve.
enum FailureMode {
  OFF_BY_ONE
  MISSED_EDGE_CASE
  WRONG_COMPLEXITY // e.g. wrote O(n^2) when O(n) was required
  MISREAD_CONSTRAINTS
  WRONG_APPROACH // picked the wrong algorithm/pattern entirely
  SYNTAX_ERROR
  RAN_OUT_OF_TIME
}

/// Where an attempt row came from.
enum AttemptSource {
  MANUAL // you logged it here, with full detail
  IMPORTED // derived from your LeetCode submission history (minutes/confidence unknown)
}

// ----------------------------------------------------------------------------
// Models (tables)
// ----------------------------------------------------------------------------

/// One LeetCode problem. Rows are created by the catalog sync script (a later
/// milestone), not by hand.
model Problem {
  id Int @id @default(autoincrement())

  // --- Identity from LeetCode -------------------------------------------
  /// The number shown in LeetCode's UI, e.g. 1 for "Two Sum".
  lcFrontendId Int    @unique @map("lc_frontend_id")
  /// URL slug, e.g. "two-sum". Unique and stable — good for lookups.
  slug         String @unique
  title        String

  difficulty Difficulty
  /// Acceptance rate as a percentage (e.g. 38.6), from LeetCode. Null until the
  /// catalog sync has populated it.
  acRate     Float?     @map("ac_rate")
  /// Full problem URL, stored so the frontend can link straight out to it.
  url        String
  /// LeetCode locks some problems behind a paid account; we store those thin.
  isPremium  Boolean    @default(false) @map("is_premium")

  /// When the catalog sync last refreshed this row.
  syncedAt DateTime @default(now()) @map("synced_at")

  /// The problem statement as HTML, fetched from LeetCode the first time it's
  /// viewed. Null until then; null forever for premium problems.
  descriptionHtml     String?   @map("description_html")
  descriptionSyncedAt DateTime? @map("description_synced_at")

  // --- Relations -------------------------------------------------------
  /// The problem's LeetCode topic tags, via the join table.
  topics         ProblemTopic[]
  attempts       Attempt[]
  /// Raw submissions imported from your LeetCode account.
  submissions    Submission[]
  /// Your before-attempt pattern guesses for this problem.
  predictions    Prediction[]
  /// Failure modes you have actually hit on this problem (built lazily).
  failureModes   ProblemFailureMode[]
  /// Zero or one schedule row — created the first time you log an attempt.
  reviewSchedule ReviewSchedule?

  @@map("problems")
}

/// A LeetCode "topic tag" — the algorithm / data-structure categories LeetCode
/// assigns to problems (e.g. "Dynamic Programming", "Two Pointers"). Rows are
/// created by the catalog sync, same as problems.
model Topic {
  id   Int    @id @default(autoincrement())
  /// URL-safe identifier from LeetCode, e.g. "two-pointers". Stable, unique.
  slug String @unique
  /// Human-readable label, e.g. "Two Pointers".
  name String

  problems ProblemTopic[]

  @@map("topics")
}

/// Join table for the many-to-many between Problem and Topic. We model it
/// explicitly (rather than letting Prisma hide it) so later features can query
/// "which problems share this topic" directly. The primary key is the pair of
/// foreign keys, so a problem can't be linked to the same topic twice.
model ProblemTopic {
  problemId Int @map("problem_id")
  topicId   Int @map("topic_id")

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([problemId, topicId])
  // Index the second column too — the pair index alone doesn't help queries
  // that start from a topic.
  @@index([topicId])
  @@map("problem_topics")
}

/// One logged practice attempt at a problem. This is the raw event data every
/// other feature (scheduling, recommendations, dashboards) is derived from.
model Attempt {
  id Int @id @default(autoincrement())

  problemId Int     @map("problem_id")
  // onDelete: Cascade => if a Problem row is ever deleted, its attempts go too.
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  attemptedAt DateTime @default(now()) @map("attempted_at")

  /// MANUAL attempts always have minutes + confidence (the endpoint requires
  /// them). IMPORTED attempts leave them null.
  source AttemptSource @default(MANUAL)

  outcome Outcome
  /// Minutes spent. Null for imported attempts.
  minutes Int?
  /// Self-rated 1-5. Null for imported attempts. Range enforced in the endpoint
  /// (Postgres can't express a numeric range on a plain column cleanly).
  confidence Int?

  /// Only set when the attempt wasn't a clean solve. Nullable.
  failureMode FailureMode? @map("failure_mode")
  /// Free-text scratch notes, optional.
  notes       String?

  // Index because we constantly query "all attempts for problem X".
  @@index([problemId])
  @@map("attempts")
}

/// Spaced-repetition state for a problem, one row per problem you've attempted
/// at least once. Updated by the SM-2 algorithm (next milestone) after every
/// attempt. Using `problemId` itself as the primary key enforces the
/// one-row-per-problem rule at the database level.
model ReviewSchedule {
  problemId Int     @id @map("problem_id")
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  /// SM-2 "ease factor" — how fast the interval grows. Starts at 2.5, floored
  /// at 1.3 by the algorithm.
  easeFactor Float @default(2.5) @map("ease_factor")
  /// Current gap between reviews, in days.
  intervalDays Int @default(0) @map("interval_days")
  /// How many times in a row you've recalled this well. Resets to 0 on a lapse.
  repetitions Int @default(0)

  /// The date the recommendation queue considers this problem "due".
  nextReviewDate DateTime @map("next_review_date")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("review_schedule")
}

/// A before-attempt guess at which technique(s) a problem needs. Compared
/// against the problem's real LeetCode topic tags once you log an attempt, so
/// pattern recognition can be scored separately from execution.
model Prediction {
  id Int @id @default(autoincrement())

  problemId Int     @map("problem_id")
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  /// Topic slugs you guessed, e.g. ["two-pointers", "binary-search"].
  predictedTopicSlugs String[] @map("predicted_topic_slugs")

  createdAt DateTime @default(now()) @map("created_at")

  /// Set when an attempt resolves this prediction. While null, this is the
  /// single "open" prediction for the problem.
  resolvedAt        DateTime? @map("resolved_at")
  /// Did any guessed slug appear in the problem's real tags? Null until resolved.
  hit              Boolean?
  /// The guessed slugs that turned out to be real tags. Empty until resolved.
  matchedTopicSlugs String[] @map("matched_topic_slugs")

  // Fast lookup of "the open prediction for problem X".
  @@index([problemId, resolvedAt])
  @@map("predictions")
}

/// A failure mode you have actually hit on a problem, with how often and how
/// recently. Built lazily: a row appears the first time you log an attempt with
/// that failure mode on that problem, never pre-populated. The recommendation
/// engine reads this to weight problems toward your recent weak spots.
model ProblemFailureMode {
  problemId   Int         @map("problem_id")
  failureMode FailureMode @map("failure_mode")

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  /// How many attempts on this problem hit this failure mode.
  count      Int      @default(0)
  /// When it was last hit.
  lastSeenAt DateTime @map("last_seen_at")

  @@id([problemId, failureMode])
  @@index([failureMode])
  @@map("problem_failure_modes")
}

/// A faithful cache of one submission from your LeetCode account, pulled by the
/// `sync:submissions` script. This is raw imported data — your reflective
/// `Attempt` rows are created separately and are never overwritten by a re-sync.
model Submission {
  /// LeetCode's own submission id. Stored as text because we only ever match on
  /// it, never do arithmetic, and it sidesteps big-integer handling.
  lcSubmissionId String @id @map("lc_submission_id")

  /// Link to our catalog. Nullable because, in rare cases, a submission may be
  /// for a problem not present in our `problems` table (e.g. removed by
  /// LeetCode). `titleSlug` is kept regardless so it can be re-linked later.
  problemId Int?     @map("problem_id")
  problem   Problem? @relation(fields: [problemId], references: [id], onDelete: SetNull)
  titleSlug String   @map("title_slug")

  lang          String
  /// LeetCode's human-readable status, e.g. "Accepted", "Wrong Answer",
  /// "Time Limit Exceeded".
  statusDisplay String  @map("status_display")
  /// Convenience flag derived from statusDisplay == "Accepted", so "have I
  /// solved this?" queries don't have to string-match.
  isAccepted    Boolean @map("is_accepted")
  runtime       String?
  memory        String?
  /// Full source code of the submission.
  code          String

  /// When the submission was made on LeetCode (from their unix timestamp).
  submittedAt DateTime @map("submitted_at")
  /// When our sync first stored this row.
  importedAt  DateTime @default(now()) @map("imported_at")

  @@index([problemId])
  @@index([titleSlug])
  @@index([submittedAt])
  @@map("submissions")
}

/// App configuration — a single row (id is always 1). Holds the LeetCode account
/// connection entered through the onboarding screen.
///
/// `leetcodeSession` / `leetcodeCsrf` are stored in plaintext, the same trust
/// level as the server's .env file. Fine for a local single-user tool; do not
/// deploy this publicly without encrypting them.
model Settings {
  id Int @id @default(1)

  leetcodeUsername  String? @map("leetcode_username")
  leetcodeSession   String? @map("leetcode_session")
  leetcodeCsrf      String? @map("leetcode_csrf")
  /// URL of your LeetCode profile picture, refreshed on connect / sync.
  leetcodeAvatarUrl String? @map("leetcode_avatar_url")

  /// When the submission import last completed.
  submissionsSyncedAt DateTime? @map("submissions_synced_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}
