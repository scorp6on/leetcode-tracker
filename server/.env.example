# Copy this file to `.env` and adjust if needed.
#
# Connection string format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
# The USER / PASSWORD / DATABASE here match docker-compose.yml.
# Port 5433: the container is mapped there because this machine already runs a
# native PostgreSQL on 5432.
DATABASE_URL="postgresql://leetcode:leetcode@localhost:5433/leetcode_tracker?schema=public"

# Port the Express API listens on.
PORT=4000

# Set to "true" to log every SQL statement Prisma runs. Leave unset otherwise.
# PRISMA_LOG_QUERIES=true

# How often the server auto-runs an incremental LeetCode submission sync, in
# minutes. Default 5. Set to 0 to turn auto-sync off (you can still sync from
# the app or the CLI).
# SYNC_INTERVAL_MINUTES=5

# ---------------------------------------------------------------------------
# LeetCode account access.
#
# The normal way to connect is the app's first-run "Connect LeetCode" screen,
# which stores these in the database. Setting them here is the CLI-only path,
# used when the DB row is empty (e.g. to run `npm run sync:submissions` before
# the frontend exists).
#
#   1. Log in to https://leetcode.com in your browser.
#   2. Open dev tools -> Application/Storage -> Cookies -> https://leetcode.com
#   3. Copy the values of LEETCODE_SESSION and csrftoken below.
#      LEETCODE_USERNAME is optional (display only).
#
# These are credentials. `.env` is gitignored — keep it that way. The session
# expires every few weeks; re-copy the cookies when a sync returns 401/403.
LEETCODE_SESSION=
LEETCODE_CSRF=
LEETCODE_USERNAME=
