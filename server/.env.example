# Copy this file to `.env` and adjust if needed.
#
# Connection string format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
# The USER / PASSWORD / DATABASE here match docker-compose.yml.
# Port 5433: the container is mapped there because this machine already runs a
# native PostgreSQL on 5432.
DATABASE_URL="postgresql://leetcode:leetcode@localhost:5433/leetcode_tracker?schema=public"

# Port the Express API listens on.
PORT=4000
